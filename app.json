{
  "expo": {
    "name": "SoundShelf",
    "slug": "SoundShelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/SoundShelf.png",
    "scheme": "soundshelf",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-ios.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#185048",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nadelemon.SoundShelf",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-strip-activity-fragment-state",
      "expo-router",
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#185048",
          "image": "./assets/SoundShelf.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
